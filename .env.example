# All optional. Copy to .env and run with: node --env-file=.env server/index.js
PORT=3001
# Cache lifetime for upstream data, in seconds
CACHE_TTL_SECONDS=600
# Where the forecast log for the live track record is kept (default: ./data)
# DATA_DIR=/var/lib/stock-forecast
# --- Claude AI layer (off until a key is set) ---
# Get a key at https://console.anthropic.com and set it here; never commit it.
# ANTHROPIC_API_KEY=
# Model: claude-fable-5-2 is the most capable (default). claude-opus-5-5 costs about half.
# AI_MODEL=claude-fable-5-2
# Thinking depth: low | medium | high | xhigh | max
# AI_EFFORT=high
# Hard cap on Claude API calls per day
# AI_DAILY_CALL_LIMIT=200

# Reddit works with no account (public JSON). REDDIT_DISABLED=1 turns it off.
# Optional keys switch to the official API ("script" app at https://www.reddit.com/prefs/apps):
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_SUBREDDITS=stocks+wallstreetbets+investing+StockMarket+options
